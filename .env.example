# Public base URL for local development and future links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# SMTP transport used by the app for server-side reservation forwarding.
SMTP_URL=smtp://localhost:1025

# Sender identity used when the app forwards reservation requests.
EMAIL_FROM=reservations@example.com

# Operator destination for reservation request emails.
CONTACT_EMAIL=hello@example.com

# Admin password used to establish an operator session for /admin routes.
ADMIN_PASSWORD=change-this-admin-password

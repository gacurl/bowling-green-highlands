# Local development template. Configure Vercel Preview and Production separately.
# See docs/production-deployment-gate.md#stripe-environment-isolation.

# Public base URL used for local links and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# SMTP transport used by the app for server-side reservation forwarding.
SMTP_URL=smtp://localhost:1025

# Secret used to sign short-lived reservation confirmation cookies.
CONFIRMATION_COOKIE_SECRET=change-this-confirmation-cookie-secret

# Sender identity used when the app forwards reservation requests.
EMAIL_FROM=reservations@example.com

# Operator destination for reservation request emails.
CONTACT_EMAIL=hello@example.com

# Bootstrap and owner-authorized break-glass credential; not the normal owner password after initialization.
ADMIN_PASSWORD=change-this-admin-password

# Explicit gate for first-time bootstrap or owner-authorized break-glass recovery.
# Leave disabled during normal operation, including when credential state is missing.
BGH_ADMIN_RECOVERY_MODE=disabled

# Optional durable path for the server-only owner credential state.
BGH_ADMIN_CREDENTIAL_STORE_PATH=data/admin-owner-credential.json

# Stripe test-mode secret key used server-side for local Checkout.
STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key

# Matching Stripe test-mode Price ID used for local Checkout.
STRIPE_CHECKOUT_PRICE_ID=replace-with-stripe-test-price-id

# Signing secret for the test webhook endpoint targeting this local environment.
STRIPE_WEBHOOK_SECRET=replace-with-local-test-webhook-secret

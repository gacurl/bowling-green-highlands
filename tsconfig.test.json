{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "app/lib/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
